{
  "name": "dex-signup-agent-demo",
  "private": true,
  "version": "0.1.0",
  "description": "A Dex agent that reviews Dex Cloud sign-ups and asks admins in Slack before it approves an account or sends a welcome email",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "test": "node --test --test-force-exit --test-concurrency=1 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.323",
    "@earendil-works/pi-agent-core": "1.5.1",
    "@earendil-works/pi-ai": "1.5.1",
    "@earendil-works/pi-schema": "1.5.1",
    "@superdurable/connector-google-gmail": "0.2.2",
    "@superdurable/connector-slack": "0.6.0",
    "@superdurable/connectors-sdk": "0.10.0",
    "@superdurable/dex": "1.45.3",
    "@superdurable/dex-agents": "0.6.8",
    "@superdurable/dex-agents-claude-agent-sdk": "0.6.8",
    "@superdurable/dex-agents-pi": "0.6.8",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@superdurable/dex": "$@superdurable/dex",
    "@superdurable/connectors-sdk": "$@superdurable/connectors-sdk"
  },
  "main": "dist/main.js"
}
