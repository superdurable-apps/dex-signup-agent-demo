# Copy to .env and fill in. `npm start` loads .env; never commit it.

# --- Dex -------------------------------------------------------------------------------------------
# Local `dexcli dev` (the default). For a remote Dex server, set the address, DEX_TLS=true, and the
# API key exchange: DEX_API_KEY, DEX_TOKEN_URL and DEX_SERVER_ID.
DEX_FLOW_SERVICE_ADDRESS=127.0.0.1:8801
# DEX_TLS=true
# DEX_API_KEY=
# DEX_TOKEN_URL=
# DEX_SERVER_ID=

# --- Dex Cloud account review API (staging) --------------------------------------------------------
# The demo reviews the sign-ups of Dex Cloud staging (https://dex.superdurable.io). The public host
# of its review API is set when the API is exposed; put it here then.
REVIEW_API_URL=https://review-api.example.invalid
# The key `srk_<id>_<secret>` a Dex Cloud platform admin issued for this demo. Secret.
REVIEW_API_KEY=
# Required: only sign-ups registered at or after this RFC 3339 time are reviewed, so the backlog is left alone.
SIGNUP_REVIEW_SINCE=2026-11-13T00:00:00Z

# --- Slack -----------------------------------------------------------------------------------------
# Channel ID of the review posts (channel details > Copy channel ID), such as C0123456789.
# The Slack app must be a member of the channel. The reply Trigger takes replies in this channel only.
SLACK_REVIEW_CHANNEL=
# Member IDs (profile > Copy member ID) whose replies count, separated by commas.
SIGNUP_REVIEWER_SLACK_IDS=

# --- Connectors ------------------------------------------------------------------------------------
# The Dex connector configuration with the connections `review-slack` (Slack, with the app-level token in
# its app_token field for Socket Mode) and `welcome-gmail` (Gmail). Dex Web of `dexcli dev` writes it; see
# the README. Use an absolute path.
DEX_CONNECTOR_CONFIG_FILE=/Users/you/.dex/connectors/connections.json

# --- Agent -----------------------------------------------------------------------------------------
# pi or claude-agent-sdk (npm start); make run-eino runs the Eino harness. Each harness has its own session Flow type:
# finish the open reviews before switching.
SIGNUP_AGENT_HARNESS=pi
# pi: a <provider>/<model ID> of pi-ai's catalog, and the provider's key (ANTHROPIC_API_KEY is required for anthropic/…).
SIGNUP_AGENT_PI_MODEL=anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=
# pi with an OpenAI-compatible Chat Completions endpoint instead: its base URL (the part before /chat/completions)
# selects it; then SIGNUP_AGENT_PI_MODEL is the endpoint's plain model ID, slashes included (meta-llama/Llama-3),
# and its key is required. ANTHROPIC_API_KEY is not needed. A model ID that starts with a pi-ai catalog provider,
# such as openai/gpt-oss-120b, is written openai-compatible/openai/gpt-oss-120b (the older openai-compatible/<model ID>
# form works for any ID).
# SIGNUP_AGENT_PI_BASE_URL=https://llm.example.com/v1
# SIGNUP_AGENT_PI_MODEL=qwen3.8-flash-next
# SIGNUP_AGENT_PI_API_KEY=
# Optional, only with SIGNUP_AGENT_PI_BASE_URL: the endpoint's API, openai (the default) or anthropic. With anthropic
# the base URL is the part before /v1/messages (such as https://llm.example.com/anthropic), the model is its plain ID
# (no openai-compatible/ prefix), and SIGNUP_AGENT_PI_API_KEY is sent as x-api-key; ANTHROPIC_API_KEY is never used.
# SIGNUP_AGENT_PI_PROTOCOL=openai
# Eino (make run-eino, the Go process in eino/): an OpenAI-compatible Chat Completions endpoint (the default) or, with
# SIGNUP_AGENT_EINO_PROTOCOL=anthropic, an Anthropic-compatible Messages endpoint. Its base URL, model ID and key are
# required. With openai the base URL is the part before /chat/completions and the key goes as a Bearer token; with
# anthropic it is the part before /v1/messages and the key goes as x-api-key. make run-eino sets SIGNUP_AGENT_HARNESS=eino.
# SIGNUP_AGENT_EINO_BASE_URL=https://llm.example.com/v1
# SIGNUP_AGENT_EINO_MODEL=qwen3.8-flash-next
# SIGNUP_AGENT_EINO_API_KEY=
# SIGNUP_AGENT_EINO_PROTOCOL=openai
# Claude Agent SDK: the model, and how the Claude Code CLI signs in: `login` uses the Claude Code login on this
# machine (run `claude` and /login once), `api-key` uses ANTHROPIC_API_KEY.
SIGNUP_AGENT_CLAUDE_MODEL=claude-opus-5-5
SIGNUP_AGENT_CLAUDE_AUTH=login
# Optional: a Claude Code CLI to run instead of the one the Claude Agent SDK bundles.
# SIGNUP_AGENT_CLAUDE_CLI=
# Optional: a GitHub token raises the public API's rate limit for github_user.
# GITHUB_TOKEN=

# Seconds between two reads of the pending sign-ups.
SIGNUP_WATCH_INTERVAL_SECONDS=30
# Worker execution slots; a running turn or tool call takes one, a review that waits for a reply takes none.
SIGNUP_WORKER_SLOTS=64

# The onboarding wizard (docs/onboarding.md): a Vercel AI SDK agent that takes over each account approve_account
# approves, tracks its usage and follows up when it stalls. Off unless true.
ONBOARDING_ENABLED=false
# Only accounts approved since this RFC 3339 time are onboarded.
# ONBOARDING_SINCE=2026-11-23T00:00:00Z
# The usage operations (docs/usage-api.md). Dex Cloud does not serve them yet: point them at the stand-in,
# npm run usage-standin, which prints its URL and key.
# ONBOARDING_USAGE_API_URL=http://127.0.0.1:8872
# ONBOARDING_USAGE_API_KEY=
# The model: an Anthropic model ID with ANTHROPIC_API_KEY (claude-opus-5-5 by default), or the model ID of an
# OpenAI-compatible endpoint with ONBOARDING_AGENT_BASE_URL (the part before /chat/completions) and its key.
# ONBOARDING_AGENT_MODEL=claude-opus-5-5
# ONBOARDING_AGENT_BASE_URL=
# ONBOARDING_AGENT_API_KEY=
# Seconds between two rounds of the onboarding watcher, and the follow-up limits.
# ONBOARDING_WATCH_INTERVAL_SECONDS=60
# ONBOARDING_MAX_NUDGES=3
# ONBOARDING_MIN_NUDGE_GAP_DAYS=3
# ONBOARDING_WINDOW_DAYS=30
